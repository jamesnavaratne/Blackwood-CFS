name = "blackwood-cfs-admin-gateway"
main = "worker.js"
compatibility_date = "2026-11-01"

# URLs must match the actual published admin app and GitHub repository.
[vars]
ADMIN_ORIGIN = "https://jamesnavaratne.github.io"
ADMIN_URL = "https://jamesnavaratne.github.io/Blackwood-CFS/admin/"
GITHUB_REPO = "jamesnavaratne/Blackwood-CFS"
DEFAULT_BRANCH = "main"
ALLOWED_LOGINS = "jamesnavaratne"
GITHUB_CLIENT_ID = "de1b3a2ed37e41abafcf95c2738783eb"

# Create a KV namespace and replace ID:
[[kv_namespaces]]
binding = "SESSIONS"
id = "REPLACE_WITH_KV_NAMESPACE_ID"

# Secret, NOT in TOML or GitHub repository:
# npx wrangler secret put GITHUB_CLIENT_SECRET
